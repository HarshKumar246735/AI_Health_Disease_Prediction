# Port (Render sets this automatically)
PORT=5000
# MongoDB Atlas connection string (or mongodb://127.0.0.1:27017/healthpredict locally)
MONGODB_URI=
# Long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Allowed browser origin(s) for CORS. Comma-separate multiple, no trailing slash.
CLIENT_URL=http://localhost:5173
# URL of the Python ML service
ML_SERVICE_URL=http://localhost:8000
# Optional: must match ML_API_KEY on the ML service
ML_API_KEY=
# Used only by `npm run seed:admin`
ADMIN_NAME=Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
